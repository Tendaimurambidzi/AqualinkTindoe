rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isAuthed() && request.auth.uid == ownerUid;
    }

    function isAppAdmin() {
      return isAuthed() && (
        request.auth.token.appRole == 'admin' ||
        request.auth.token.appRole == 'owner' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole in ['admin', 'owner'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appAdmin == true
      );
    }

    function isAppOwner() {
      return isAuthed() && (
        request.auth.token.appRole == 'owner' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'owner'
      );
    }

    function isPremiumHost() {
      return isAuthed()
        && (
          resource == null
            ? request.resource.data.hostUid == request.auth.uid
            : resource.data.hostUid == request.auth.uid
        );
    }

    function isPremiumShowHost(showId) {
      return isAuthed()
        && get(/databases/$(database)/documents/premium_shows/$(showId)).data.hostUid == request.auth.uid;
    }

    function isPremiumShowHostAfter(showId) {
      return isAuthed()
        && getAfter(/databases/$(database)/documents/premium_shows/$(showId)).data.hostUid == request.auth.uid;
    }

    function isFleetMember(fleetId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/fleets/$(fleetId)/crew/$(request.auth.uid));
    }

    function isFleetCaptain(fleetId) {
      return isAuthed()
        && get(/databases/$(database)/documents/fleets/$(fleetId)).data.captainUid == request.auth.uid;
    }

    function isPremiumTicketClaim() {
      return isAuthed()
        && resource.data.claimedByUid == null
        && request.resource.data.claimedByUid == request.auth.uid
        && (
          !('status' in request.resource.data) ||
          request.resource.data.status == 'claimed'
        );
    }

    // ---- Engagement updates allowed for NON-owners ----
    // This supports two patterns:
    // A) counts map: counts.echoes / counts.splashes
    // B) legacy top-level: echoesCount / splashesCount
    // Plus optional preview fields and updatedAt.
    function isLegitEngagementUpdate() {
      let changedTop = request.resource.data.diff(resource.data).changedKeys();

      // Allow ONLY these top-level fields to change for non-owners:
      // counts OR legacy counters OR lastEcho preview OR updatedAt
      let topOk = changedTop.hasOnly([
        'counts',
        'echoesCount',
        'splashesCount',
        'lastEchoText',
        'lastEchoBy',
        'lastEchoAt',
        'updatedAt'
      ]);

      // ---- counts-map mode checks ----
      let oldCounts = resource.data.counts;
      let newCounts = request.resource.data.counts;
      let safeOldCounts = oldCounts == null ? {} : oldCounts;

      // If counts exists in request, only echoes/splashes/hugs may change
      let countsKeysOk =
        (newCounts == null) ||
        newCounts.diff(safeOldCounts).changedKeys().hasOnly(['echoes','splashes','hugs']);

      let countsTypesOk =
        (newCounts == null) ||
        (
          (!('echoes' in newCounts) || newCounts.echoes is number) &&
          (!('splashes' in newCounts) || newCounts.splashes is number) &&
          (!('hugs' in newCounts) || newCounts.hugs is number)
        );

      // ---- legacy counter mode checks ----
      let legacyOk =
        (!('echoesCount' in request.resource.data) || request.resource.data.echoesCount is number) &&
        (!('splashesCount' in request.resource.data) || request.resource.data.splashesCount is number);

      // ---- preview fields checks (optional) ----
      let previewOk =
        (!('lastEchoText' in request.resource.data) || request.resource.data.lastEchoText is string) &&
        (!('lastEchoBy' in request.resource.data) || request.resource.data.lastEchoBy is string) &&
        (!('lastEchoAt' in request.resource.data) || request.resource.data.lastEchoAt is timestamp);

      return topOk && countsKeysOk && countsTypesOk && legacyOk && previewOk;
    }

    // waves/{waveId}
    match /waves/{waveId} {
      allow read: if true;

      allow create: if isAuthed()
                    && request.resource.data.ownerUid == request.auth.uid
                    && (
                      // Public posts are always allowed
                      request.resource.data.audience == 'public' ||
                      // Fleet posts require user to be fleet member
                      (
                        request.resource.data.audience == 'fleet' &&
                        request.resource.data.fleetId != null &&
                        isFleetMember(request.resource.data.fleetId)
                      ) ||
                      // Private posts require recipient validation
                      (
                        request.resource.data.audience == 'private' &&
                        request.resource.data.privateRecipientUids != null &&
                        request.resource.data.privateRecipientUids is list &&
                        request.resource.data.privateRecipientUids.size() > 0
                      )
                    );

      // Owner can update freely.
      // Non-owners can ONLY do legit engagement updates.
      allow update: if isAuthed() && (
        resource.data.ownerUid == request.auth.uid ||
        isLegitEngagementUpdate()
      );

      // Owner or admin can delete
      allow delete: if isAuthed()
                    && (resource.data.ownerUid == request.auth.uid || isAppAdmin());

      // waves/{waveId}/splashes/{uid}
      match /splashes/{uid} {
        allow read: if true;

        allow create: if isAuthed()
                      && uid == request.auth.uid
                      && request.resource.data.userUid == request.auth.uid;

        allow update: if false;

        allow delete: if isAuthed() && uid == request.auth.uid;
      }

      // waves/{waveId}/echoes/{echoId}
      match /echoes/{echoId} {
        allow read: if true;

        // Allow create with either "userUid" or "authorId" field
        // (some clients use authorId; this makes it work for everyone)
        allow create: if isAuthed()
                      && (
                        (request.resource.data.userUid == request.auth.uid) ||
                        (request.resource.data.authorId == request.auth.uid)
                      )
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;

        // Update only by the author; only text can change
        allow update: if isAuthed() && (
                      (
                        (
                          (resource.data.userUid == request.auth.uid) ||
                          (resource.data.authorId == request.auth.uid)
                        )
                        && request.resource.data.diff(resource.data)
                             .changedKeys().hasOnly(["text", "updatedAt"])
                      ) ||
                      (
                        request.resource.data.diff(resource.data)
                          .changedKeys().hasOnly(["hugs", "huggedBy"])
                        && (!('hugs' in request.resource.data) || request.resource.data.hugs is number)
                        && (!('huggedBy' in request.resource.data) || request.resource.data.huggedBy is map)
                      )
                    );

        allow delete: if isAuthed()
                      && (
                        (resource.data.userUid == request.auth.uid) ||
                        (resource.data.authorId == request.auth.uid)
                      );
      }
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if isAuthed();
      allow create: if isAuthed() && request.auth.uid == uid;
      // Owner can update their profile; admins can update other users for moderation
      allow update: if isOwner(uid) || isAppAdmin();
      allow delete: if isAppOwner();

      match /pings/{pingId} {
        allow read, create, update, delete: if isAuthed();
      }

      match /crew/{memberId} {
        allow read: if isAuthed();
        allow create, delete: if isAuthed()
                              && memberId == request.auth.uid;
        allow update: if false;
      }

      match /boarding/{targetId} {
        allow read: if isOwner(uid);
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }

      match /fleets/{fleetId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /recentPosters/{posterId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if isOwner(uid);
      }

      match /mentions/{mentionId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isAuthed();
      }

      match /messages/{messageId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isAuthed();
      }

      match /direct_calls/{callId} {
        allow read: if isOwner(uid);

        allow create: if isAuthed()
          && request.resource.data.callerUid is string
          && request.resource.data.calleeUid is string
          && (uid == request.resource.data.callerUid || uid == request.resource.data.calleeUid)
          && (request.auth.uid == request.resource.data.callerUid || request.auth.uid == request.resource.data.calleeUid);

        allow update, delete: if isAuthed()
          && resource.data.callerUid is string
          && resource.data.calleeUid is string
          && (uid == resource.data.callerUid || uid == resource.data.calleeUid)
          && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);
      }

      // users/{uid}/live_invites/{inviteId}
      // Sender writes invites into recipient inbox; recipient reads/responds.
      match /live_invites/{inviteId} {
        // Keep invite flow robust across sender/recipient operations.
        allow read, create, update: if isAuthed();
        allow delete: if isAuthed() && (
          isOwner(uid) ||
          (
            resource.data.fromUid is string &&
            resource.data.fromUid == request.auth.uid
          )
        );
      }
    }

    match /fleets/{fleetId} {
      allow read: if isAuthed()
        && (
          resource.data.visibility == 'open' ||
          isFleetMember(fleetId)
        );

      allow create: if isAuthed()
        && request.resource.data.captainUid == request.auth.uid
        && request.resource.data.crewCount is number
        && request.resource.data.crewCount == 1;

      allow update: if isAuthed() && (
        isFleetCaptain(fleetId) ||
        (
          isFleetMember(fleetId) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'crewCount',
            'lastActivityText',
            'lastActivityAt',
            'updatedAt',
            'lastWaveText',
            'lastWaveAt'
          ])
        )
      );

      allow delete: if isFleetCaptain(fleetId);

      match /crew/{uid} {
        allow read: if isAuthed()
          && (
            get(/databases/$(database)/documents/fleets/$(fleetId)).data.visibility == 'open' ||
            isFleetMember(fleetId)
          );

        allow create: if isAuthed()
          && (
            uid == request.auth.uid ||
            isFleetCaptain(fleetId)
          )
          && (
            get(/databases/$(database)/documents/fleets/$(fleetId)).data.visibility == 'open' ||
            isFleetCaptain(fleetId)
          );

        allow update, delete: if isAuthed()
          && (
            uid == request.auth.uid ||
            isFleetCaptain(fleetId)
          );
      }

      match /messages/{messageId} {
        allow read: if isFleetMember(fleetId);

        allow create: if isFleetMember(fleetId)
          && request.resource.data.fromUid == request.auth.uid;

        allow update, delete: if false;
      }
    }

    // live/{liveId}/invite_status/{uid}
    // Host writes pending status; invitee updates accepted/missed.
    match /live/{liveId} {
      allow read: if isAuthed();
      allow create, update, delete: if isAuthed();

      match /invite_status/{uid} {
        allow read: if isAuthed();
        allow create, update, delete: if isAuthed();
      }

      match /comments/{commentId} {
        allow read, create, update, delete: if isAuthed();
      }

      match /reactions/{reactionId} {
        allow read, create, update, delete: if isAuthed();
      }

      match /participants/{uid} {
        allow read, create, update, delete: if isAuthed();
      }

      match /shared_docs/{docId} {
        allow read, create, update, delete: if isAuthed();
      }
    }

    // Aqua Premium shows and ticketing
    match /premium_shows/{showId} {
      allow read, create, update, delete: if isAuthed();

      match /tickets/{ticketId} {
        allow read, create, update, delete: if isAuthed();
      }

      match /entries/{entryId} {
        allow read, create, update, delete: if isAuthed();
      }
    }

    // Collection group queries on "tickets" need a recursive wildcard match.
    match /{path=**}/tickets/{ticketId} {
      allow read: if isAuthed();
    }

    match /users/{uid}/premium_access/{showId} {
      allow read, create, update, delete: if isAuthed();
    }

    match /users/{uid}/premium_redemptions/{redemptionId} {
      allow read, create, update, delete: if isAuthed();
    }

    // Feed collections with destination-based routing
    match /postFeed/{postId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAppAdmin());
    }

    match /vibesFeed/{postId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAppAdmin());
    }

    match /publicFeed/{postId} {
      allow read: if isAuthed();
      allow create: if isAuthed() 
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.audience == 'public';
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAppAdmin());
    }

    match /fleetFeed/{fleetId}/{postId} {
      allow read: if isAuthed() && isFleetMember(fleetId);
      allow create: if isAuthed() 
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.audience == 'fleet'
                    && request.resource.data.fleetId == fleetId
                    && isFleetMember(fleetId);
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAppAdmin());
    }

    match /privateFeed/{uid}/{postId} {
      allow read: if isAuthed() && (request.auth.uid == uid || resource.data.ownerUid == request.auth.uid);
      allow create: if isAuthed() 
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.audience == 'private'
                    && request.resource.data.privateRecipientUids != null
                    && request.auth.uid in request.resource.data.privateRecipientUids;
      allow update: if isAuthed() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAppAdmin());
    }
  }
}
