rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isAuthed() && request.auth.uid == ownerUid;
    }

    function isAppAdmin() {
      return isAuthed() && (
        request.auth.token.appRole == 'admin' ||
        request.auth.token.appRole == 'owner' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole in ['admin', 'owner'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appAdmin == true
      );
    }

    function isAppOwner() {
      return isAuthed() && (
        request.auth.token.appRole == 'owner' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'owner'
      );
    }

    function isPremiumHost() {
      return isAuthed()
        && (
          resource == null
            ? request.resource.data.hostUid == request.auth.uid
            : resource.data.hostUid == request.auth.uid
        );
    }

    function isPremiumShowHost(showId) {
      return isAuthed()
        && get(/databases/$(database)/documents/premium_shows/$(showId)).data.hostUid == request.auth.uid;
    }

    function isPremiumShowHostAfter(showId) {
      return isAuthed()
        && getAfter(/databases/$(database)/documents/premium_shows/$(showId)).data.hostUid == request.auth.uid;
    }

    function isFleetMember(fleetId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/fleets/$(fleetId)/crew/$(request.auth.uid));
    }

    function isFleetCaptain(fleetId) {
      return isAuthed()
        && get(/databases/$(database)/documents/fleets/$(fleetId)).data.captainUid == request.auth.uid;
    }

    function isPremiumTicketClaim() {
      return isAuthed()
        && resource.data.claimedByUid == null
        && request.resource.data.claimedByUid == request.auth.uid
        && (
          !('status' in request.resource.data) ||
          request.resource.data.status == 'claimed'
        );
    }

    // Allow updates that ONLY change the top-level "counts" map (e.g., counts.echoes, counts.splashes)
    function isOnlyCountsUpdate() {
      // Check if the update only modifies the 'counts' field at the top level
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      // Allow if all affected keys are under 'counts' or just 'counts' itself
      return affectedKeys.hasOnly(['counts']) || 
             request.resource.data.diff(resource.data).changedKeys().hasOnly(['counts']);
    }

    // waves/{waveId}
    match /waves/{waveId} {
      allow read: if true; // public read; change to isAuthed() if you want private

      // Create allowed only by the owner (must provide ownerUid == auth.uid)
      allow create: if isAuthed() && request.resource.data.ownerUid == request.auth.uid;

      // Update allowed by the owner OR any authenticated user when only updating counts
      // This allows client-side atomic counters like FieldValue.increment on counts.echoes/splashes
      allow update: if isAuthed() && (
        resource.data.ownerUid == request.auth.uid || 
        isOnlyCountsUpdate()
      );

      // Delete allowed by owner OR admin
      allow delete: if isAuthed() && (resource.data.ownerUid == request.auth.uid || isAppAdmin());

      // waves/{waveId}/splashes/{uid}
      match /splashes/{uid} {
        allow read: if true;

        // Exactly one splash per user: doc id must equal auth uid on create
        allow create: if isAuthed()
                      && uid == request.auth.uid
                      && request.resource.data.userUid == request.auth.uid;

        // No updates – delete and recreate instead
        allow update: if false;

        // Unsplash: only the user who splashed can delete their own doc
        allow delete: if isAuthed() && uid == request.auth.uid;
      }

      // waves/{waveId}/echoes/{echoId}
      match /echoes/{echoId} {
        allow read: if true;

        // Create only by authed user writing their uid to userUid
        allow create: if isAuthed()
                      && request.resource.data.userUid == request.auth.uid
                      && request.resource.data.text is string;

        // Update by the author for text edits, or by any authed user for hug state only
        allow update: if isAuthed() && (
                      (
                        resource.data.userUid == request.auth.uid
                        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["text", "updatedAt"])
                      ) ||
                      (
                        request.resource.data.diff(resource.data).changedKeys().hasOnly(["hugs", "huggedBy"])
                        && (!('hugs' in request.resource.data) || request.resource.data.hugs is number)
                        && (!('huggedBy' in request.resource.data) || request.resource.data.huggedBy is map)
                      )
                    );

        // Delete only by the author
        allow delete: if isAuthed() && resource.data.userUid == request.auth.uid;
      }
    }

    // users/{uid}/pings/{pingId} – allow users to manage their own pings
    match /users/{uid} {
      // Allow any authenticated user to read user profiles (for search)
      allow read: if isAuthed();
      // Owner can update their profile; admins can also update for moderation
      allow create, update: if isOwner(uid) || isAppAdmin();
      allow delete: if isAppOwner();

      match /pings/{pingId} {
        allow read, create, update, delete: if isAuthed();
      }

      // Crew members: any authed user can add/remove themselves
      match /crew/{memberId} {
        allow read: if isAuthed();
        allow create, delete: if isAuthed() && memberId == request.auth.uid;
        allow update: if false;
      }

      // Boarding (following): owner can read, any authed user can add themselves
      match /boarding/{targetId} {
        allow read: if isOwner(uid);
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }

      match /fleets/{fleetId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      // Allow owner to read recentPosters list (populated by Cloud Functions)
      match /recentPosters/{posterId} {
        allow read: if isOwner(uid);
        // Owner may clear/prune their own list
        allow create, update, delete: if isOwner(uid);
      }

      // Mentions inbox: owner can read/update/delete; any authed user can create (send)
      match /mentions/{mentionId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isAuthed();
      }

      // Direct messages: owner can read/update/delete; any authed user can create (send)
      match /messages/{messageId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isAuthed();
      }

      // Typing indicators mirrored into the recipient's subtree.
      match /typing/{senderUid} {
        allow read: if isOwner(uid);
        allow create, update: if isAuthed()
          && request.resource.data.fromUid == request.auth.uid;
        allow delete: if isAuthed() && (
          isOwner(uid) ||
          resource.data.fromUid == request.auth.uid
        );
      }

      // Post reply typing indicators mirrored into the post owner's subtree.
      match /post_typing/{typingId} {
        allow read: if isOwner(uid);
        allow create, update: if isAuthed()
          && request.resource.data.fromUid == request.auth.uid;
        allow delete: if isAuthed() && (
          isOwner(uid) ||
          resource.data.fromUid == request.auth.uid
        );
      }

      // Live invite inbox: sender writes into recipient inbox; recipient reads/responds.
      match /live_invites/{inviteId} {
        allow read, create, update: if isAuthed();
        allow delete: if isAuthed() && (
          isOwner(uid) ||
          (
            resource.data.fromUid is string &&
            resource.data.fromUid == request.auth.uid
          )
        );
      }

      // Direct calls: both participants can read/write their mirrored call docs.
      // Caller writes to both users/{callerUid}/direct_calls/{callId}
      // and users/{calleeUid}/direct_calls/{callId}.
      match /direct_calls/{callId} {
        allow read: if isOwner(uid);

        allow create: if isAuthed()
          && request.resource.data.callerUid is string
          && request.resource.data.calleeUid is string
          && (uid == request.resource.data.callerUid || uid == request.resource.data.calleeUid)
          && (request.auth.uid == request.resource.data.callerUid || request.auth.uid == request.resource.data.calleeUid);

        allow update, delete: if isAuthed()
          && resource.data.callerUid is string
          && resource.data.calleeUid is string
          && (uid == resource.data.callerUid || uid == resource.data.calleeUid)
          && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);
      }
    }

    // Connections (followers) - new collection for follow system
    match /connections/{connectionId} {
      allow create, delete: if request.auth != null
        && request.resource.data.followerId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Notifications - new collection for follow notifications
    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && resource.data.toUserId == request.auth.uid;
      allow create: if request.auth != null;
    }

    match /fleets/{fleetId} {
      allow read: if isAuthed()
        && (
          resource.data.visibility == 'open' ||
          isFleetMember(fleetId)
        );

      allow create: if isAuthed()
        && request.resource.data.captainUid == request.auth.uid
        && request.resource.data.crewCount is number
        && request.resource.data.crewCount == 1;

      allow update: if isAuthed() && (
        isFleetCaptain(fleetId) ||
        (
          isFleetMember(fleetId) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'crewCount',
            'lastActivityText',
            'lastActivityAt',
            'updatedAt',
            'lastWaveText',
            'lastWaveAt'
          ])
        )
      );

      allow delete: if isFleetCaptain(fleetId);

      match /crew/{uid} {
        allow read: if isAuthed()
          && (
            get(/databases/$(database)/documents/fleets/$(fleetId)).data.visibility == 'open' ||
            isFleetMember(fleetId)
          );

        allow create: if isAuthed()
          && (
            uid == request.auth.uid ||
            isFleetCaptain(fleetId)
          )
          && (
            get(/databases/$(database)/documents/fleets/$(fleetId)).data.visibility == 'open' ||
            isFleetCaptain(fleetId)
          );

        allow update, delete: if isAuthed()
          && (
            uid == request.auth.uid ||
            isFleetCaptain(fleetId)
          );
      }

      match /messages/{messageId} {
        allow read: if isFleetMember(fleetId);

        allow create: if isFleetMember(fleetId)
          && request.resource.data.fromUid == request.auth.uid;

        allow update, delete: if false;
      }

      match /typing/{uid} {
        allow read: if isFleetMember(fleetId);
        allow create, update, delete: if isFleetMember(fleetId)
          && uid == request.auth.uid;
      }
    }

    // Posts collection for reach tracking
    match /waves/{postId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == resource.data.ownerUid;
    }

    match /live/{liveId} {
      allow read: if isAuthed();
      allow create, update, delete: if isAuthed();

      match /invite_status/{uid} {
        allow read, create, update, delete: if isAuthed();
      }

      match /comments/{commentId} {
        allow read, create, update, delete: if isAuthed();
      }

      match /reactions/{reactionId} {
        allow read, create, update, delete: if isAuthed();
      }

      match /participants/{uid} {
        allow read, create, update, delete: if isAuthed();
      }

      match /shared_docs/{docId} {
        allow read, create, update, delete: if isAuthed();
      }
    }

    match /premium_shows/{showId} {
      allow read, create, update, delete: if isAuthed();

      match /tickets/{ticketId} {
        allow read, create, update, delete: if isAuthed();
      }

      match /entries/{entryId} {
        allow read, create, update, delete: if isAuthed();
      }
    }

    // Collection group queries on "tickets" need a recursive wildcard match.
    match /{path=**}/tickets/{ticketId} {
      allow read: if isAuthed();
    }

    match /users/{uid}/premium_access/{showId} {
      allow read, create, update, delete: if isAuthed();
    }

    match /users/{uid}/premium_redemptions/{redemptionId} {
      allow read, create, update, delete: if isAuthed();
    }

    // Post reach subcollection - viewers list stays private
    match /waves/{postId}/reach/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow read: if false; // viewers list stays private
    }
  }
}

